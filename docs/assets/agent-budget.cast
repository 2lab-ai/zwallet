{"version": 2, "width": 104, "height": 24, "title": "zwallet: allocate, execute, verify, report (local Anvil)", "env": {"TERM": "xterm-256color"}}
[8.455, "o", "\u001b[2J\u001b[H01 / HUMAN: fund a dedicated wallet; unlock one session\r\n--------------------------------------------------------------------------------------\r\n"]
[8.455, "o", "LOCAL ANVIL / valueless ETH / automated disposable setup\r\n"]
[8.455, "o", "Allocation: 0.020 ETH | payee: @dev-service | per-tx cap: 0.005 ETH\r\n"]
[8.455, "o", "$ zwallet unlock 30m --json --password-stdin\r\n"]
[8.855, "o", "{\r\n  \"locked\": false,\r\n  \"duration\": \"30m\",\r\n  \"verified\": true,\r\n  \"verifiedBy\": \"password\"\r\n}\r\n"]
[11.861, "o", "\u001b[2J\u001b[H02 / AGENT WORKFLOW: inspect funds and preview the payment\r\n--------------------------------------------------------------------------------------\r\n"]
[11.861, "o", "$ zwallet balance --chain sepolia --json\r\n"]
[11.89, "o", "{\r\n  \"chain\": \"sepolia\",\r\n  \"symbol\": \"ETH\",\r\n  \"balance\": \"0.02\",\r\n  \"verified\": true\r\n}\r\n"]
[14.9, "o", "$ zwallet transfer --chain sepolia --to @dev-service --amount 0.001 --dry-run --json\r\n"]
[14.949, "o", "{\r\n  \"dryRun\": true,\r\n  \"amount\": \"0.001\",\r\n  \"sufficientFunds\": true,\r\n  \"whitelist\": {\r\n    \"allowed\": true\r\n  }\r\n}\r\n"]
[17.959, "o", "\u001b[2J\u001b[H03 / AGENT WORKFLOW: send and verify, without another password\r\n--------------------------------------------------------------------------------------\r\n"]
[17.959, "o", "$ zwallet transfer --chain sepolia --to @dev-service --amount 0.001 --wait --json\r\n"]
[18.035, "o", "{\r\n  \"amount\": \"0.001\",\r\n  \"txHash\": \"0x505f351b431113de51bb0096cb059567aacfb66d8d4cf86c0ffdb9ff8c02e331\",\r\n  \"status\": \"success\",\r\n  \"success\": true,\r\n  \"gasUsed\": 21000\r\n}\r\n"]
[21.046, "o", "$ zwallet tx --chain sepolia 0x505f351b431113de51bb0096cb059567aacfb66d8d4cf86c0ffdb9ff8c02e331 --json\r\n"]
[21.061, "o", "{\r\n  \"found\": true,\r\n  \"status\": \"mined\",\r\n  \"success\": true,\r\n  \"gasUsed\": 21000\r\n}\r\n"]
[24.065, "o", "\u001b[2J\u001b[H04 / POLICY: an over-limit request is refused before signing\r\n--------------------------------------------------------------------------------------\r\n"]
[24.066, "o", "$ zwallet transfer --chain sepolia --to @dev-service --amount 0.006 --wait --json\r\n"]
[24.117, "o", "{\r\n  \"errorCode\": \"WHITELIST_DENIED\",\r\n  \"error\": \"refusing to sign: per-transaction native value cap exceeded on sepolia\"\r\n}\r\n"]
[27.119, "o", "\u001b[2J\u001b[H05 / REPORT: account for the spend, fee and remaining allocation\r\n--------------------------------------------------------------------------------------\r\n"]
[27.12, "o", "$ zwallet balance --chain sepolia --json\r\n"]
[27.154, "o", "{\r\n  \"symbol\": \"ETH\",\r\n  \"balance\": \"0.018978999999979\"\r\n}\r\n"]
[30.166, "o", "# Example script report (computed; NOT a built-in zwallet command)\r\n"]
[30.166, "o", "Confirmed: 1 | spent: 0.001 ETH | fee: 0.000021000000021 ETH\r\n"]
[30.166, "o", "Remaining: 0.018978999999979 ETH | over-limit request: refused\r\n"]
[34.167, "o", "\u001b[2J\u001b[H06 / HUMAN CONTROL: end the session\r\n--------------------------------------------------------------------------------------\r\n"]
[34.167, "o", "$ zwallet lock --json\r\n"]
[34.258, "o", "{\r\n  \"locked\": true,\r\n  \"wasUnlocked\": true\r\n}\r\n"]
